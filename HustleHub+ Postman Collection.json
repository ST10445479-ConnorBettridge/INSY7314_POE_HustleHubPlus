                  "});",
                  "pm.test('Error message contains validation details', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('Password');",
                  "});",
                  "pm.test('No internal details exposed', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.not.have.property('stack');",
                  "    pm.expect(jsonData).to.not.have.property('file');",
                  "});"
