# Copy this file to .env, then fill in real values.
# NEVER commit the real .env file (it is git-ignored).
#
#   bash:        cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env

# Port the HTTPS server listens on (must match the Android app's 10.0.2.2:3443)
PORT=3443

# JWT signing secret. MUST be 32+ random characters or the server refuses to start.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-32-plus-character-random-string

# JWT expiry
JWT_EXPIRES_IN=1h

# development | production | test
NODE_ENV=development
