<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores a JWT in EncryptedSharedPreferences. Neither cloud backup nor
  device-to-device transfer should carry that off the device, so both are
  excluded outright. android:allowBackup="false" already covers Android 11 and
  below; this file is the Android 12+ equivalent.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
